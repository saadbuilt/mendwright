yle=\"background:#fff;border-radius:14px;padding:24px 26px;width:430px;box-shadow:0 10px 40px rgba(0,0,0,.25)\">\n    <div style=\"font-weight:700;font-size:19px;margin-bottom:8px\">We value your privacy</div>\n    <div style=\"color:#57606a;font-size:15px;line-height:1.45;margin-bottom:18px\">We use cookies to improve your\n      experience and measure traffic. You can accept or reject non-essential cookies.</div>\n    <div style=\"display:flex;gap:10px\">\n      <button type=\"button\" onclick=\"document.getElementById('cc-wrap').remove()\"\n        style=\"flex:1;padding:11px;border-radius:8px;border:1px solid #d0d7de;background:#fff;font-size:15px\">Reject all</button>\n      <button type=\"button\" onclick=\"document.getElementById('cc-wrap').remove()\"\n        style=\"flex:1;padding:11px;border-radius:8px;border:0;background:#3b2a86;color:#fff;font-size:15px\">Accept all</button>\n    </div>\n  </div>\n</div>\n</body></html>",
